{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    }
  ],
  "redirects": [
    { "source": "/Salderingsdienst v2.dc.html", "destination": "/", "permanent": true },
    { "source": "/Salderingsdienst v2.dc", "destination": "/", "permanent": true },
    { "source": "/Salderingsdienst%20v2.dc", "destination": "/", "permanent": true },
    { "source": "/Salderingsdienst v1.dc.html", "destination": "/", "permanent": true },
    { "source": "/Salderingsdienst v1.dc", "destination": "/", "permanent": true },
    { "source": "/Salderingsdienst%20v1.dc", "destination": "/", "permanent": true },
    { "source": "/Salderingsdienst.dc.html", "destination": "/", "permanent": true },
    { "source": "/Salderingsdienst.dc", "destination": "/", "permanent": true },
    { "source": "/Salderingsdienst (standalone).html", "destination": "/", "permanent": true },
    { "source": "/Salderingsdienst \\(standalone\\)", "destination": "/", "permanent": true },
    { "source": "/Salderingsdienst%20\\(standalone\\)", "destination": "/", "permanent": true },
    { "source": "/SalderingsDienst Landingspagina.html", "destination": "/", "permanent": true },
    { "source": "/SalderingsDienst Landingspagina", "destination": "/", "permanent": true },
    { "source": "/SalderingsDienst%20Landingspagina", "destination": "/", "permanent": true },
    { "source": "/Kennisbank.dc.html", "destination": "/kennisbank", "permanent": true },
    { "source": "/Kennisbank.dc", "destination": "/kennisbank", "permanent": true },
    { "source": "/Privacybeleid.dc.html", "destination": "/privacybeleid", "permanent": true },
    { "source": "/Privacybeleid.dc", "destination": "/privacybeleid", "permanent": true },
    { "source": "/Blog Pillar.dc.html", "destination": "/kennisbank/salderingsregeling-gids", "permanent": true },
    { "source": "/Blog Pillar.dc", "destination": "/kennisbank/salderingsregeling-gids", "permanent": true },
    { "source": "/Blog%20Pillar.dc", "destination": "/kennisbank/salderingsregeling-gids", "permanent": true },
    { "source": "/Blog Cluster.dc.html", "destination": "/kennisbank/thuisbatterij-na-2027", "permanent": true },
    { "source": "/Blog Cluster.dc", "destination": "/kennisbank/thuisbatterij-na-2027", "permanent": true },
    { "source": "/Blog%20Cluster.dc", "destination": "/kennisbank/thuisbatterij-na-2027", "permanent": true },
    { "source": "/kennisbank/artikel", "destination": "/kennisbank/thuisbatterij-na-2027", "permanent": true },
    { "source": "/voorwaarden", "destination": "/algemene-voorwaarden", "permanent": true },
    { "source": "/algemene-voorwaarden-consumenten", "destination": "/algemene-voorwaarden", "permanent": true },
    { "source": "/over-ons", "destination": "/#over-ons", "permanent": true },
    { "source": "/aanvraag", "destination": "/adviesgesprek", "permanent": true },
    { "source": "/gratis-adviesgesprek", "destination": "/adviesgesprek", "permanent": true }
  ]
}
